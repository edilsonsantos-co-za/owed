# --- PayPal (sandbox) -------------------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your REST app.
# Enable "Invoicing" and "Transaction search" on the app. Leave blank to run on demo data.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Claude (Anthropic API) --------------------------------------------------------
# console.anthropic.com -> API keys. Powers the dashboard agents and the morning brief.
ANTHROPIC_API_KEY=

# --- AG Studio ---------------------------------------------------------------------
# Optional locally (watermark + console notice without it). Free 45-day trial from AG Grid.
AG_STUDIO_LICENSE_KEY=

# --- App -----------------------------------------------------------------------------
OWED_BUSINESS_NAME=Owed Studio
# Force demo data even when PayPal credentials are set: OWED_MODE=demo
OWED_MODE=
