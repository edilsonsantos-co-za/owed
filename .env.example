# Copy to .env.local (local) — the server keeps its own .env built from the same names.
# How to get each key: docs/keys.md

# --- PayPal (sandbox) -------------------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your REST app.
# Enable "Invoicing" and "Transaction search" on the app. Leave blank to run on demo data.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Claude (Anthropic API) --------------------------------------------------------
# console.anthropic.com -> API keys. Powers the dashboard agents and the morning brief.
ANTHROPIC_API_KEY=

# --- AG Studio ---------------------------------------------------------------------
# Optional locally (watermark + console notice without it). Free 45-day trial from AG Grid.
AG_STUDIO_LICENSE_KEY=

# --- App -----------------------------------------------------------------------------
OWED_BUSINESS_NAME=Owed Studio
# Force demo data even when PayPal credentials are set: OWED_MODE=demo
OWED_MODE=
# Public URL of this app (used for the SSO callback)
OWED_BASE_URL=http://localhost:3311
# YouTube video id of the demo (the part after watch?v=), shown on the landing page
OWED_YOUTUBE_ID=

# --- Sign-in (Logto SSO) -----------------------------------------------------------
# Leave blank locally to run without sign-in. Production values are set on the server.
LOGTO_ENDPOINT=
LOGTO_INTERNAL_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Optional: Owed's own email + password sign-up (Logto M2M app with Management API access; no email sent)
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
# Any long random string: openssl rand -base64 32
SESSION_SECRET=

# Account emails (welcome, delete confirmation) through the DataSparkLab mail service; unset = mail off (logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@edilsonsantos.co.za
